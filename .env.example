# Production/Vercel: on-chain V2 only. Never put an owner's full-access key here.
GUARDIAN_MODE=testnet
POLICY_CONTRACT_ID=guardian-policy-482207.testnet
OWNER_ACCOUNT_ID=wisejaguar3455.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Separate Guardian agent account. Its key must be FunctionCall restricted to
# POLICY_CONTRACT_ID, method request_transfer only, with a finite allowance <= 1 NEAR.
GUARDIAN_ACCOUNT_ID=your-separate-guardian-agent.testnet
GUARDIAN_PRIVATE_KEY=ed25519:replace-with-restricted-function-call-secret

# Local-only preview storage. Vercel testnet activity and policy state come from NEAR.
DATABASE_PATH=./data/guardian.sqlite

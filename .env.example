# Mock mode works without any environment variables.
GUARDIAN_MODE=mock
DATABASE_PATH=./data/guardian.sqlite

# Display label for the local mock account.
GUARDIAN_ACCOUNT_ID=guardian-demo.testnet

# Optional: expected owner account for Meteor Wallet signed mock decisions.
# OWNER_ACCOUNT_ID=your-owner.testnet
# GUARDIAN_APP_ID=guardian-dawnik

# Optional V1 signer preparation. Keep real values in .env.local, never commit them.
# Live mode is testnet-only. OWNER_ACCOUNT_ID must equal GUARDIAN_ACCOUNT_ID.
# The owner retains its Meteor Wallet full-access key; the server key must be another active full-access key on that same testnet account.
# GUARDIAN_MODE=testnet
# GUARDIAN_ACCOUNT_ID=your-protected-account.testnet
# OWNER_ACCOUNT_ID=your-protected-account.testnet
# GUARDIAN_PRIVATE_KEY=ed25519:replace-with-testnet-secret-key
# NEAR_RPC_URL=https://rpc.testnet.near.org
# FASTNEAR_API_KEY=replace-with-testnet-history-api-key
# TRUSTED_RECIPIENTS=vendor.testnet,friend.testnet

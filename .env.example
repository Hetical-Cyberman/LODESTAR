# Mock mode works without any environment variables.
GUARDIAN_MODE=mock
DATABASE_PATH=./data/guardian.sqlite

# Display label for the local mock account.
GUARDIAN_ACCOUNT_ID=guardian-demo.testnet

# Optional: expected owner account for HOT Wallet signed mock decisions.
# OWNER_ACCOUNT_ID=your-owner.testnet
# GUARDIAN_APP_ID=guardian-dawnik

# Optional V1 signer preparation. Keep real values in .env.local, never commit them.
# Testnet only: use a dedicated Guardian account/key with test funds, never an owner/mainnet key.
# GUARDIAN_MODE=testnet
# GUARDIAN_ACCOUNT_ID=your-guardian.testnet
# GUARDIAN_PRIVATE_KEY=ed25519:replace-with-testnet-secret-key
# NEAR_RPC_URL=https://rpc.testnet.near.org
